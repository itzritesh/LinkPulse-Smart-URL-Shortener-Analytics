# ==============================================================================
# LinkPulse — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' for local docker-compose development:
#   cp .env.example .env
# For production deployments, consult '.env.production.example' and DEPLOYMENT.md.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Application Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="LinkPulse"
ENVIRONMENT="development"        # "development" | "staging" | "production"
DEBUG="True"                     # Set to "False" in production environments

# ------------------------------------------------------------------------------
# 2. PostgreSQL Relational Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER="linkpulse"
POSTGRES_PASSWORD="linkpulse_dev_password_only"
POSTGRES_DB="linkpulse_db"
POSTGRES_PORT=5432

# In docker-compose, the database hostname is 'postgres'.
# For external cloud databases (e.g. Neon, AWS RDS, Supabase), paste the connection string:
DATABASE_URL="postgresql://linkpulse:linkpulse_dev_password_only@postgres:5432/linkpulse_db"

# ------------------------------------------------------------------------------
# 3. Redis High-Performance Cache Configuration
# ------------------------------------------------------------------------------
REDIS_ENABLED="True"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
REDIS_CACHE_TTL_SECONDS=3600     # Cached short code TTL in seconds (1 hour)
REDIS_SOCKET_TIMEOUT=1.0         # Fast-fail socket timeout in seconds (graceful fallback)

# ------------------------------------------------------------------------------
# 4. Authentication & JWT Security Configuration
# ------------------------------------------------------------------------------
# Generate a strong 64-char key using: openssl rand -hex 32
JWT_SECRET_KEY="insecure-dev-secret-key-change-this-for-production-use-32chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080 # 7 days (7 * 24 * 60)

# ------------------------------------------------------------------------------
# 5. Networking, CORS & Reverse Proxy Settings
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcard '*' is disallowed in production mode.
CORS_ORIGINS="http://localhost,http://localhost:80,http://localhost:5173,http://127.0.0.1:5173,http://127.0.0.1"

# Service Host Ports
BACKEND_PORT=8000
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 6. Frontend Build Arguments (Injected at Docker Build Time)
# ------------------------------------------------------------------------------
# In production with Nginx reverse-proxy, use '/api' to eliminate CORS completely.
VITE_API_BASE_URL="/api"
VITE_BACKEND_URL=""
