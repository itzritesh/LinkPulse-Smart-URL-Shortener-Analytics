# ==============================================================================
# LinkPulse — Production Environment Configuration
# ==============================================================================
# IMPORTANT: Never commit actual production secrets to version control.
# Copy this template onto your production server as '.env' and populate with
# securely generated credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Production Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="LinkPulse"
ENVIRONMENT="production"
DEBUG="False"

# ------------------------------------------------------------------------------
# 2. Production PostgreSQL Database (Dedicated Container or Cloud Managed DB)
# ------------------------------------------------------------------------------
POSTGRES_USER="linkpulse_admin"
POSTGRES_PASSWORD="GENERATE_A_VERY_LONG_SECURE_PASSWORD_HERE"
POSTGRES_DB="linkpulse_production"
POSTGRES_PORT=5432

# For Docker Compose self-hosted:
DATABASE_URL="postgresql://linkpulse_admin:GENERATE_A_VERY_LONG_SECURE_PASSWORD_HERE@postgres:5432/linkpulse_production"
# For Managed RDS/Neon/Supabase over SSL:
# DATABASE_URL="postgresql://user:pass@ep-hostname.region.aws.neon.tech/linkpulse_production?sslmode=require"

# ------------------------------------------------------------------------------
# 3. Production Redis Cache (Memory Capped with LRU Eviction)
# ------------------------------------------------------------------------------
REDIS_ENABLED="True"
REDIS_PORT=6379
REDIS_URL="redis://redis:6379/0"
# For authenticated cloud Redis (e.g. Upstash, AWS ElastiCache):
# REDIS_URL="rediss://:YourAuthPassword@redis-host:6379/0"
REDIS_CACHE_TTL_SECONDS=3600
REDIS_SOCKET_TIMEOUT=1.0

# ------------------------------------------------------------------------------
# 4. JWT Authentication (Cryptographically Strong Random Secret)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_SECRET_KEY="REPLACE_WITH_MINIMUM_64_CHAR_CRYPTOGRAPHIC_RANDOM_SECRET_KEY"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ------------------------------------------------------------------------------
# 5. Production Domain & CORS Alignment
# ------------------------------------------------------------------------------
# Exact list of origins allowed to perform authenticated requests.
# Replace with your actual domain names.
CORS_ORIGINS="https://linkpulse.io,https://app.linkpulse.io,https://www.linkpulse.io"

BACKEND_PORT=8000
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 6. Frontend Build Configuration
# ------------------------------------------------------------------------------
# In production behind Nginx reverse proxy or Cloudflare:
VITE_API_BASE_URL="/api"
VITE_BACKEND_URL="https://linkpulse.io"
