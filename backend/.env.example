# LinkPulse Production Environment Configuration Template
# Copy to .env and configure strong values before deploying

PROJECT_NAME=LinkPulse
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api

HOST=0.0.0.0
PORT=8000

# CORS Allowed Origins (Comma-separated list or JSON array of trusted frontend domains)
# Example: https://app.linkpulse.io,https://linkpulse.io
CORS_ORIGINS=https://app.linkpulse.io,https://linkpulse.io

# PostgreSQL Connection String (SSL mode recommended for production/Neon/Supabase/RDS)
DATABASE_URL=postgresql://linkpulse_user:CHANGE_ME_PASSWORD@db.region.postgres.cloud:5432/linkpulse_prod?sslmode=require

# JWT Authentication Secret Key
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_THIS_TO_A_CRYPTOGRAPHICALLY_SECURE_64_CHAR_RANDOM_SECRET_KEY
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis Cache Configuration (Optional - graceful fallback to PostgreSQL if unavailable)
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

